# ----------------------------
# Kafka (core infrastructure)
# ----------------------------
# Used by docker-compose for Kafka and Kafka UI.
# Wired in via --env-file core.env in the Taskfile.

# Ports
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=29093
KAFKA_UI_PORT=8090

# Docker image versions
KAFKA_IMAGE=confluentinc/cp-kafka:8.2.0
KAFKA_UI_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0

# ----------------------------
# Observability
# ----------------------------
# Used by docker-compose for the observability stack.

# Docker image versions
JAEGER_IMAGE=jaegertracing/jaeger:2.17.0
PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
GRAFANA_IMAGE=grafana/grafana:13.0.1
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.4.0
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.4.0
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.151.0

# Ports
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
OTEL_GRPC_PORT=4317
OTEL_METRICS_PORT=8888

# ----------------------------
# Containerization
# ----------------------------
# Used by docker-compose for the services, Nginx and the Redis rate limiter.

# Host port on which Nginx (the load balancer in front of OrderService) accepts HTTP traffic.
HTTP_PORT=8080

# Redis rate limiter port (for connecting from the host through localhost)
REDIS_RATELIMIT_PORT=6379

# Docker image versions
NGINX_IMAGE=nginx:1.30.0-alpine3.23
REDIS_RATELIMIT_IMAGE=redis:8.6.1-alpine3.23

# ----------------------------
# Application builds (build args for the Dockerfiles)
# ----------------------------
# They are referenced from build.args in the compose files (services, iam, inventory, order)
# and picked up by the Taskfile through dotenv. Change versions here, in one place.
GO_IMAGE=golang:1.26-alpine3.23
ALPINE_IMAGE=alpine:3.23
GOOSE_VERSION=v3.27.1

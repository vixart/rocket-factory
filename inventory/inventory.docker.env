# Configuration overrides for running IN A CONTAINER (task up-all).
# Passed via env_file in deploy/compose/services/docker-compose.yml and overrides
# inventory/config.docker.yaml (env > yaml).
#
# The local counterpart is inventory/inventory.env (host addresses).

APP_ENV=docker

GRPC_HOST=0.0.0.0
GRPC_PORT=50051

POSTGRES_HOST=postgres-inventory
POSTGRES_PORT=5432
POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service-user
POSTGRES_PASSWORD=inventory-service-password

IAM_ADDRESS=iam-service:50053

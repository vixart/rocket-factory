# Переопределения конфигурации для КОНТЕЙНЕРНОГО запуска (task up-all).
# Передаётся через env_file в deploy/compose/services/docker-compose.yml и
# перебивает inventory/config.docker.yaml (env > yaml).
#
# Локальный аналог — inventory/inventory.env (хостовые адреса).

APP_ENV=docker

GRPC_HOST=0.0.0.0
GRPC_PORT=50051

POSTGRES_HOST=postgres-inventory
POSTGRES_PORT=5432
POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service-user
POSTGRES_PASSWORD=inventory-service-password

IAM_ADDRESS=iam-service:50053

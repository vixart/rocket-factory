POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service-user
POSTGRES_PASSWORD=inventory-service-password
POSTGRES_PORT=55433

DB_URI=postgres://inventory-service-user:inventory-service-password@localhost:55433/inventory-service?sslmode=disable
MIGRATIONS_DIR=migrations/inventory

# Версии Docker-образов
POSTGRES_IMAGE=postgres:18.3-alpine3.23

GRPC_HOST=localhost
GRPC_PORT=50051

CONFIG_PATH=config.local.yaml

IAM_ADDRESS=localhost:50053
# Переопределения конфигурации для ЛОКАЛЬНОГО запуска сервиса.
# Файл читает сам сервис (godotenv в cmd/main.go, относительно рабочей директории),
# а cleanenv ставит env выше YAML — значения отсюда перебивают inventory/config.local.yaml.
# Поэтому все адреса здесь хостовые.
#
# Контейнерный аналог — inventory/inventory.docker.env (адреса внутри docker-сети).
# Настройки контейнера БД — в deploy/compose/inventory/compose.env.
#
# Окружение: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

# Должны совпадать с deploy/compose/inventory/compose.env — иначе локальный сервис
# пойдёт не в ту БД, которую поднял docker compose.
POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service-user
POSTGRES_PASSWORD=inventory-service-password
POSTGRES_PORT=55433

GRPC_HOST=localhost
GRPC_PORT=50051

CONFIG_PATH=config.local.yaml

IAM_ADDRESS=localhost:50053
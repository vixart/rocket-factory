# Configuration overrides for running the service LOCALLY.
# The service itself reads this file (godotenv in cmd/main.go, relative to the working
# directory), and cleanenv ranks env above YAML, so these values override inventory/config.local.yaml.
# That is why every address here is a host address.
#
# The container counterpart is inventory/inventory.docker.env (addresses inside the docker network).
# Settings of the database container live in deploy/compose/inventory/compose.env.
#
# Environment: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

# Must match deploy/compose/inventory/compose.env, otherwise the local service talks to a
# different database than the one docker compose started.
POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service-user
POSTGRES_PASSWORD=inventory-service-password
POSTGRES_PORT=55433

GRPC_HOST=localhost
GRPC_PORT=50051

CONFIG_PATH=config.local.yaml

IAM_ADDRESS=localhost:50053
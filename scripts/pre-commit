#!/bin/bash

# Git pre-commit hook: formats the staged Go files and runs the linter.
#
# Install with: task hooks:install
# (a plain copy without chmod +x does not work: git silently skips
# non-executable hooks)

export PATH="$HOME/.local/bin:$PATH"

set -euo pipefail

# The hook runs from the repository root, but the cd makes invocation from anywhere
# (IDEs, GUI clients) predictable.
cd "$(git rev-parse --show-toplevel)"

BIN_DIR="$(pwd)/bin"
GOFUMPT="$BIN_DIR/gofumpt"
GCI="$BIN_DIR/gci"
MODULE_PREFIX="github.com/vixart/rocket-factory"

# Format only what is going into the commit: a repository-wide run would drag other
# people's files into it.
mapfile -t STAGED < <(
  git diff --cached --name-only --diff-filter=ACM -- '*.go' |
    grep -vE '(/mocks/|/pkg/proto/|/pkg/openapi/|^some_info/)' || true
)

if [ ${#STAGED[@]} -eq 0 ]; then
  echo "🧼 No Go files staged — skipping formatting"
else
  if [ ! -x "$GOFUMPT" ] || [ ! -x "$GCI" ]; then
    echo "📦 Formatters not found, installing..."
    task formatters:install
  fi

  echo "🧼 Formatting staged files (${#STAGED[@]})..."
  "$GOFUMPT" -extra -w "${STAGED[@]}"
  "$GCI" write -s standard -s default -s "prefix($MODULE_PREFIX)" "${STAGED[@]}"

  # Put the formatted files back into the index, otherwise the pre-format version is
  # committed and the changes linger in the working tree.
  #
  # Careful: for a partially staged file (git add -p) this also picks up its unstaged
  # changes.
  git add -- "${STAGED[@]}"
fi

echo "🔍 Running the linter..."
task lint

echo "✅ All clean!"

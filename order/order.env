# Файл читают: docker compose (POSTGRES_* для контейнера БД) и сам сервис при
# локальном запуске (godotenv в cmd/main.go). Контейнеру сервиса он НЕ передаётся —
# там свой config.docker.yaml через CONFIG_PATH. Поэтому все адреса здесь — хостовые.
#
# Окружение: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

POSTGRES_DB=order-service
POSTGRES_USER=order-service-user
POSTGRES_PASSWORD=order-service-password
POSTGRES_PORT=55432

# Версии Docker-образов
POSTGRES_IMAGE=postgres:18.3-alpine3.23

INVENTORY_ADDRESS=localhost:50051
PAYMENT_ADDRESS=localhost:50052
IAM_ADDRESS=localhost:50053

HTTP_HOST=localhost
HTTP_PORT=8080

KAFKA_BROKERS=localhost:9092
ORDER_PAID_TOPIC_NAME=order.paid
SHIP_ASSEMBLED_CONSUMER_GROUP_ID=order-service-ship-assembled-consumer
SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled

REDIS_RATE_LIMIT_ADDRESS=localhost:6379
REDIS_RATE_LIMIT_RATE=100
REDIS_RATE_LIMIT_BURST=200
# Переопределения конфигурации для ЛОКАЛЬНОГО запуска сервиса.
# Файл читает сам сервис (godotenv в cmd/main.go, относительно рабочей директории),
# а cleanenv ставит env выше YAML — значения отсюда перебивают order/config.local.yaml.
# Поэтому все адреса здесь хостовые.
#
# Контейнеру сервиса файл НЕ передаётся: там свой order/config.docker.yaml
# через CONFIG_PATH. Настройки контейнера БД и версии образов живут отдельно —
# в deploy/compose/order/compose.env.
#
# Окружение: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

# Должны совпадать с deploy/compose/order/compose.env — иначе локальный сервис
# пойдёт не в ту БД, которую поднял docker compose.
POSTGRES_DB=order-service
POSTGRES_USER=order-service-user
POSTGRES_PASSWORD=order-service-password
POSTGRES_PORT=55432

INVENTORY_ADDRESS=localhost:50051
PAYMENT_ADDRESS=localhost:50052
IAM_ADDRESS=localhost:50053

HTTP_HOST=localhost
HTTP_PORT=8080

KAFKA_BROKERS=localhost:9092
ORDER_PAID_TOPIC_NAME=order.paid
SHIP_ASSEMBLED_CONSUMER_GROUP_ID=order-service-ship-assembled-consumer
SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled

REDIS_RATE_LIMIT_ADDRESS=localhost:6379
REDIS_RATE_LIMIT_RATE=100
REDIS_RATE_LIMIT_BURST=200
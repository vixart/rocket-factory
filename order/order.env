# Configuration overrides for running the service LOCALLY.
# The service itself reads this file (godotenv in cmd/main.go, relative to the working
# directory), and cleanenv ranks env above YAML, so these values override order/config.local.yaml.
# That is why every address here is a host address.
#
# The file is NOT passed to the service container: it uses order/config.docker.yaml
# via CONFIG_PATH. Database container settings and image versions live separately, in
# deploy/compose/order/compose.env.
#
# Environment: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

# Must match deploy/compose/order/compose.env, otherwise the local service talks to a
# different database than the one docker compose started.
POSTGRES_DB=order-service
POSTGRES_USER=order-service-user
POSTGRES_PASSWORD=order-service-password
POSTGRES_PORT=55432

INVENTORY_ADDRESS=localhost:50051
PAYMENT_ADDRESS=localhost:50052
IAM_ADDRESS=localhost:50053

HTTP_HOST=localhost
HTTP_PORT=8080

KAFKA_BROKERS=localhost:9092
ORDER_PAID_TOPIC_NAME=order.paid
SHIP_ASSEMBLED_CONSUMER_GROUP_ID=order-service-ship-assembled-consumer
SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled

REDIS_RATE_LIMIT_ADDRESS=localhost:6379
REDIS_RATE_LIMIT_RATE=100
REDIS_RATE_LIMIT_BURST=200
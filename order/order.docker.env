# Configuration overrides for running IN A CONTAINER (task up-all).
# The file is passed to the container via env_file in deploy/compose/services/docker-compose.yml,
# and cleanenv ranks env above YAML, so these values override order/config.docker.yaml.
# That is why every address here is a docker network service name, not localhost.
#
# The local counterpart is order/order.env (host addresses).

APP_ENV=docker

# Listen on every interface: otherwise Nginx cannot reach the container.
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

POSTGRES_HOST=postgres-order
POSTGRES_PORT=5432
POSTGRES_DB=order-service
POSTGRES_USER=order-service-user
POSTGRES_PASSWORD=order-service-password

INVENTORY_ADDRESS=inventory-service:50051
PAYMENT_ADDRESS=payment-service:50052
IAM_ADDRESS=iam-service:50053

KAFKA_BROKERS=kafka:29092
ORDER_PAID_TOPIC_NAME=order.paid
SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled
SHIP_ASSEMBLED_CONSUMER_GROUP_ID=order-service-ship-assembled-consumer

REDIS_RATE_LIMIT_ADDRESS=redis-ratelimit:6379
REDIS_RATE_LIMIT_RATE=100
REDIS_RATE_LIMIT_BURST=200

# Configuration overrides for running the service LOCALLY.
# The service itself reads this file (godotenv in cmd/main.go, relative to the working
# directory), and cleanenv ranks env above YAML, so these values override iam/config.local.yaml.
# That is why every address here is a host address.
#
# The container counterpart is iam/iam.docker.env (addresses inside the docker network).
# Settings of the database and Redis containers live in deploy/compose/iam/compose.env.
#
# Environment: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

# Must match deploy/compose/iam/compose.env, otherwise the local service talks to a
# different database than the one docker compose started.
POSTGRES_DB=iam-service
POSTGRES_USER=iam-service-user
POSTGRES_PASSWORD=iam-service-password
POSTGRES_PORT=55434

GRPC_HOST=localhost
GRPC_PORT=50053

# Redis
# Host port 6380 rather than 6379, to avoid clashing with the core redis-ratelimit
# during `task up-all`. Inside the docker network redis-iam still listens on 6379.
REDIS_HOST=localhost
REDIS_PORT=6380

# Sessions
SESSION_TTL=24h

CONFIG_PATH=config.local.yaml

# Переопределения конфигурации для ЛОКАЛЬНОГО запуска сервиса.
# Файл читает сам сервис (godotenv в cmd/main.go, относительно рабочей директории),
# а cleanenv ставит env выше YAML — значения отсюда перебивают iam/config.local.yaml.
# Поэтому все адреса здесь хостовые.
#
# Контейнерный аналог — iam/iam.docker.env (адреса внутри docker-сети).
# Настройки контейнеров БД и Redis — в deploy/compose/iam/compose.env.
#
# Окружение: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

# Должны совпадать с deploy/compose/iam/compose.env — иначе локальный сервис
# пойдёт не в ту БД, которую поднял docker compose.
POSTGRES_DB=iam-service
POSTGRES_USER=iam-service-user
POSTGRES_PASSWORD=iam-service-password
POSTGRES_PORT=55434

GRPC_HOST=localhost
GRPC_PORT=50053

# Redis
# Хостовый порт 6380 (а не 6379), чтобы не конфликтовать с redis-ratelimit из core
# при `task up-all`. Внутри docker-сети redis-iam всё равно слушает 6379.
REDIS_HOST=localhost
REDIS_PORT=6380

# Сессии
SESSION_TTL=24h

CONFIG_PATH=config.local.yaml

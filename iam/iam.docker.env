# Configuration overrides for running IN A CONTAINER (task up-all).
# Passed via env_file in deploy/compose/services/docker-compose.yml and overrides
# iam/config.docker.yaml (env > yaml).
#
# The local counterpart is iam/iam.env (host addresses).

APP_ENV=docker

GRPC_HOST=0.0.0.0
GRPC_PORT=50053

POSTGRES_HOST=postgres-iam
POSTGRES_PORT=5432
POSTGRES_DB=iam-service
POSTGRES_USER=iam-service-user
POSTGRES_PASSWORD=iam-service-password

# Inside the docker network redis-iam listens on 6379 (the 6380 host mapping is irrelevant here).
REDIS_HOST=redis-iam
REDIS_PORT=6379

SESSION_TTL=24h

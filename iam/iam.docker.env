# Переопределения конфигурации для КОНТЕЙНЕРНОГО запуска (task up-all).
# Передаётся через env_file в deploy/compose/services/docker-compose.yml и
# перебивает iam/config.docker.yaml (env > yaml).
#
# Локальный аналог — iam/iam.env (хостовые адреса).

APP_ENV=docker

GRPC_HOST=0.0.0.0
GRPC_PORT=50053

POSTGRES_HOST=postgres-iam
POSTGRES_PORT=5432
POSTGRES_DB=iam-service
POSTGRES_USER=iam-service-user
POSTGRES_PASSWORD=iam-service-password

# Внутри docker-сети redis-iam слушает 6379 (хостовой маппинг 6380 здесь не при чём).
REDIS_HOST=redis-iam
REDIS_PORT=6379

SESSION_TTL=24h

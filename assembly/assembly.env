# Configuration overrides for running the service LOCALLY.
# The service itself reads this file (godotenv in cmd/main.go, relative to the working
# directory), and cleanenv ranks env above YAML, so these values override assembly/config.local.yaml.
# That is why every address here is a host address.
#
# The container counterpart is assembly/assembly.docker.env (addresses inside the docker network).
#
# Environment: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

KAFKA_BROKERS=localhost:9092

ORDER_PAID_TOPIC_NAME=order.paid
ORDER_PAID_CONSUMER_GROUP_ID=assembly-service-order-paid-consumer

SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled

# CONFIG_PATH=config.local.yaml

# Переопределения конфигурации для ЛОКАЛЬНОГО запуска сервиса.
# Файл читает сам сервис (godotenv в cmd/main.go, относительно рабочей директории),
# а cleanenv ставит env выше YAML — значения отсюда перебивают assembly/config.local.yaml.
# Поэтому все адреса здесь хостовые.
#
# Контейнерный аналог — assembly/assembly.docker.env (адреса внутри docker-сети).
#
# Окружение: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

KAFKA_BROKERS=localhost:9092

ORDER_PAID_TOPIC_NAME=order.paid
ORDER_PAID_CONSUMER_GROUP_ID=assembly-service-order-paid-consumer

SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled

# CONFIG_PATH=config.local.yaml

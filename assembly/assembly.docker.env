# Переопределения конфигурации для КОНТЕЙНЕРНОГО запуска (task up-all).
# Передаётся через env_file в deploy/compose/services/docker-compose.yml и
# перебивает assembly/config.docker.yaml (env > yaml).
#
# Локальный аналог — assembly/assembly.env (хостовые адреса).

APP_ENV=docker

KAFKA_BROKERS=kafka:29092
ORDER_PAID_TOPIC_NAME=order.paid
ORDER_PAID_CONSUMER_GROUP_ID=assembly-service-order-paid-consumer
SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled

# Configuration overrides for running IN A CONTAINER (task up-all).
# Passed via env_file in deploy/compose/services/docker-compose.yml and overrides
# assembly/config.docker.yaml (env > yaml).
#
# The local counterpart is assembly/assembly.env (host addresses).

APP_ENV=docker

KAFKA_BROKERS=kafka:29092
ORDER_PAID_TOPIC_NAME=order.paid
ORDER_PAID_CONSUMER_GROUP_ID=assembly-service-order-paid-consumer
SHIP_ASSEMBLED_TOPIC_NAME=assembly.ship-assembled

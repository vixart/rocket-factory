# Что НЕ отправлять демону в build context.
#
# Контекст у всех сервисных сборок — корень репозитория (context: ../../.. в
# deploy/compose/services/docker-compose.yml), и он уезжает демону целиком на
# каждую из шести сборок. Без этого файла это ~294 МБ, из которых 289 МБ — bin/
# с бинарниками инструментов разработки (buf, golangci-lint, goose и прочие).
# Они не нужны сборке и вдобавок ломают кеш: любая переустановка инструмента
# меняет контекст и инвалидирует слой COPY . . во всех образах сразу.

.git
.gitignore

# Инструменты разработки — ставятся на хосте через task *:install
bin/

# Артефакты тестов и покрытия
coverage/

# Файлы, к сборке не относящиеся
*.md
.claude/
.github/
.golangci.yml
.mockery.yaml
.mockery_boilerplate_text.txt
Taskfile.yaml

# What NOT to send to the daemon in the build context.
#
# Every service build uses the repository root as its context (context: ../../.. in
# deploy/compose/services/docker-compose.yml) and ships it whole to the daemon on each
# of the six builds. Without this file that is ~294 MB, 289 MB of which is bin/ with the
# development tool binaries (buf, golangci-lint, goose and friends).
# The build does not need them and they break the cache: reinstalling any tool changes
# the context and invalidates the COPY . . layer in every image at once.

.git
.gitignore

# Development tools — installed on the host via task *:install
bin/

# Test and coverage artifacts
coverage/

# Files unrelated to the build
*.md
.claude/
.github/
.golangci.yml
.mockery.yaml
.mockery_boilerplate_text.txt
Taskfile.yaml

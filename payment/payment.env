# Configuration overrides for running the service LOCALLY.
# The service itself reads this file (godotenv in cmd/main.go, relative to the working
# directory), and cleanenv ranks env above YAML, so these values override payment/config.local.yaml.
#
# The container counterpart is payment/payment.docker.env.
#
# Environment: docker, development, staging, production
APP_ENV=development

ENABLE_OTLP=true

GRPC_HOST=localhost
GRPC_PORT=50052

CONFIG_PATH=config.local.yaml

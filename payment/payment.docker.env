# Переопределения конфигурации для КОНТЕЙНЕРНОГО запуска (task up-all).
# Передаётся через env_file в deploy/compose/services/docker-compose.yml и
# перебивает payment/config.docker.yaml (env > yaml).
#
# Локальный аналог — payment/payment.env (хостовые адреса).

APP_ENV=docker

GRPC_HOST=0.0.0.0
GRPC_PORT=50052

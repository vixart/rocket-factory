# Переменные для docker compose Order-сервиса: подставляются в docker-compose.yml
# и передаются контейнеру PostgreSQL. Приложение этот файл не читает —
# его конфигурация живёт в order/config.local.yaml (локально)
# и order/config.docker.yaml (в контейнере).

POSTGRES_DB=order-service
POSTGRES_USER=order-service-user
POSTGRES_PASSWORD=order-service-password
# Хостовый порт: по нему ходят сервисы, запущенные локально, и goose из migrate:order:*
POSTGRES_PORT=55432

POSTGRES_IMAGE=postgres:18.3-alpine3.23

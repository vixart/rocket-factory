# Variables for the Order docker compose stack: they are interpolated into docker-compose.yml
# docker-compose.yml and passed to the PostgreSQL container. The application does not read
# this file: its configuration lives in order/config.local.yaml (locally)
# and order/config.docker.yaml (in the container).

POSTGRES_DB=order-service
POSTGRES_USER=order-service-user
POSTGRES_PASSWORD=order-service-password
# Host port used by locally running services and by goose in migrate:order:*
POSTGRES_PORT=55432

POSTGRES_IMAGE=postgres:18.3-alpine3.23

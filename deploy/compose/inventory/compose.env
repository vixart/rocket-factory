# Variables for the Inventory docker compose stack: they are interpolated into
# docker-compose.yml and passed to the PostgreSQL container. The application does not read
# this file: its configuration lives in inventory/config.local.yaml (locally)
# and inventory/config.docker.yaml (in the container).

POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service-user
POSTGRES_PASSWORD=inventory-service-password
# Host port used by locally running services and by goose in migrate:inventory:*
POSTGRES_PORT=55433

POSTGRES_IMAGE=postgres:18.3-alpine3.23

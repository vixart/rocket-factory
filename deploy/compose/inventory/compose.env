# Переменные для docker compose Inventory-сервиса: подставляются в docker-compose.yml
# и передаются контейнеру PostgreSQL. Приложение этот файл не читает —
# его конфигурация живёт в inventory/config.local.yaml (локально)
# и inventory/config.docker.yaml (в контейнере).

POSTGRES_DB=inventory-service
POSTGRES_USER=inventory-service-user
POSTGRES_PASSWORD=inventory-service-password
# Хостовый порт: по нему ходят сервисы, запущенные локально, и goose из migrate:inventory:*
POSTGRES_PORT=55433

POSTGRES_IMAGE=postgres:18.3-alpine3.23

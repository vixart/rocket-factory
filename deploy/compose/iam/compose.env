# Переменные для docker compose IAM-сервиса: подставляются в docker-compose.yml
# и передаются контейнеру PostgreSQL. Приложение этот файл не читает —
# его конфигурация живёт в iam/config.local.yaml (локально)
# и iam/config.docker.yaml (в контейнере).

POSTGRES_DB=iam-service
POSTGRES_USER=iam-service-user
POSTGRES_PASSWORD=iam-service-password
# Хостовый порт: по нему ходят сервисы, запущенные локально, и goose из migrate:iam:*
POSTGRES_PORT=55434

# Хостовый порт 6380 (а не 6379), чтобы не конфликтовать с redis-ratelimit из core
# при `task up-all`. Внутри docker-сети redis-iam всё равно слушает 6379.
REDIS_PORT=6380

POSTGRES_IMAGE=postgres:18.3-alpine3.23
REDIS_IMAGE=redis:8.6.3-alpine3.23

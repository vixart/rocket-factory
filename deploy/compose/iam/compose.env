# Variables for the IAM docker compose stack: they are interpolated into docker-compose.yml
# docker-compose.yml and passed to the PostgreSQL container. The application does not read
# this file: its configuration lives in iam/config.local.yaml (locally)
# and iam/config.docker.yaml (in the container).

POSTGRES_DB=iam-service
POSTGRES_USER=iam-service-user
POSTGRES_PASSWORD=iam-service-password
# Host port used by locally running services and by goose in migrate:iam:*
POSTGRES_PORT=55434

# Host port 6380 rather than 6379, to avoid clashing with the core redis-ratelimit
# during `task up-all`. Inside the docker network redis-iam still listens on 6379.
REDIS_PORT=6380

POSTGRES_IMAGE=postgres:18.3-alpine3.23
REDIS_IMAGE=redis:8.6.3-alpine3.23
